{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/server", "scripts"],
  "exclude": ["node_modules", "dist", "src/frontend", "tests"]
}
