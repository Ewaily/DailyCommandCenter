# ─────────────────────────────────────────────────────────────
# Daily Command Center — .gitignore
# Zero tolerance for leaked secrets, local DBs, or user state.
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp/
.pnp.js
jspm_packages/

# Build artifacts
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo

# Environment & secrets — NEVER COMMIT
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.p12
secrets/
credentials/

# Local databases & user data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
data/
db/
.daily-command-center/

# User-specific layout / workspace state
layout_config.json
layout_config.*.json
workspace_data/
user_data/
tokens.json
session.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test & coverage
coverage/
.nyc_output/
.vitest/

# Editor / IDE
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Claude / agent local state
.claude/settings.local.json
.claude/launch.json

# Misc
*.tgz
*.tar.gz
.tmp/
tmp/
coverage/
