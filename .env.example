# ─────────────────────────────────────────────────────────────
# Daily Command Center — Environment template
# Copy this file to `.env` and fill in the values you need.
# Every integration is OPTIONAL — leave blank to disable that card.
# ─────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
DB_PATH=~/.daily-command-center/db.sqlite
LOG_LEVEL=info

# ── Vite dev server (frontend, proxied by Node in dev mode) ──
VITE_PORT=5173

# ── Google (OAuth) ─────────────────────────────────────────
# Create a Web OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Slack (OAuth) ──────────────────────────────────────────
# Create an app at https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/auth/slack/callback
# Optional shortcut: paste a User OAuth Token directly (xoxp-...) to skip the OAuth flow.
SLACK_USER_TOKEN=
SLACK_USER_ID=

# ── Microsoft (OAuth) ──────────────────────────────────────
# Register an app at https://portal.azure.com (App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ── Linear (API key) ───────────────────────────────────────
# Personal API key from https://linear.app/settings/api
LINEAR_API_KEY=

# ── Jira (API token) ───────────────────────────────────────
# Token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── GitHub (PAT) ───────────────────────────────────────────
# Fine-grained or classic PAT from https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=

# ── Notion (Internal integration) ──────────────────────────
# Token from https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DATABASE_IDS=
