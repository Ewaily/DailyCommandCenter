{
  "name": "daily-command-center",
  "version": "1.0.2",
  "description": "Local morning dashboard — Calendar, Slack, Linear, Jira, GitHub, Notion in one tab.",
  "type": "module",
  "license": "MIT",
  "author": "Muhammad Ewaily",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ewaily/DailyCommandCenter.git"
  },
  "homepage": "https://github.com/Ewaily/DailyCommandCenter#readme",
  "bugs": {
    "url": "https://github.com/Ewaily/DailyCommandCenter/issues"
  },
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:vite": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "reset-db": "tsx scripts/reset-db.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "googleapis": "^144.0.0",
    "http-proxy-middleware": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sanitize-html": "^2.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.1",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.14",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
